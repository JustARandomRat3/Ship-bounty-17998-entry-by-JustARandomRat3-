{
  "manifest_version": 2,
  "name": "Stretchtext",
  "version": "0.1.0",
  "description": "Shorten selected text and expand it inline.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "https://gen.pollinations.ai/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_title": "Stretchtext",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stretchtext@example.org"
    }
  }
}
