{
  "manifest_version": 2,
  "name": "Stretchtext",
  "version": "0.1.0",
  "description": "Shorten selected text and expand it inline.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "https://gen.pollinations.ai/*",
    "https://enter.pollinations.ai/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_title": "Stretchtext",
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "stretchtext@example.org",
      "strict_min_version": "109.0"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stretchtext@example.org",
      "strict_min_version": "109.0"
    }
  }
}
